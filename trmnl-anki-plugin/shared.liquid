{% comment %}
  TRMNL prepends this file to every layout, and a mashup renders it once per view,
  so everything here has to be safe to repeat on one page.

  Each layout file renders the `anki_card` template below with its own text sizes.
  The add-on sends `note_id` and `compressed` (zlib + base64 JSON of field name -> HTML).
{% endcomment %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js"></script>

{% template anki_card %}
{% assign anki_id = "anki-" | append_random %}
<div class="layout layout--col layout--center" id="{{ anki_id }}">
  {% if compressed %}
    <div class="richtext richtext--center gap--medium w--full">
      <div class="content {{ primary_size }} text--center">
        <div data-anki-primary data-value-fit="true" data-value-fit-max-height="{{ primary_max_height }}"></div>
      </div>
      <div class="content {{ secondary_size }} text--center gap--small" data-anki-secondary
           data-content-limiter="true"></div>
    </div>
  {% else %}
    <span class="description description--large text--center">No card yet. In Anki, use Tools &gt; Refresh TRMNL.</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  {% if note_id %}
    <span class="instance">Created on: {{ note_id | divided_by: 1000 | plus: trmnl.user.utc_offset | date: '%b %d, %Y' }}</span>
  {% endif %}
</div>

{% if compressed %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const layout = document.getElementById("{{ anki_id }}");
    if (!layout) return;

    // Yoinked from https://github.com/albert7617/trmnl-japanese
    function decompressText(compressedText) {
      // Decode the base64 string to binary data
      const binaryString = atob(compressedText);

      // Convert the binary string to a Uint8Array
      const bytes = new Uint8Array(binaryString.length);
      for (let i = 0; i < binaryString.length; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }

      // Decompress using zlib (pako is a popular zlib library for browsers)
      // Note: You'll need to include pako.js for this to work
      const decompressedBytes = pako.inflate(bytes);

      // Convert the decompressed bytes back to a string
      const decoder = new TextDecoder('utf-8');
      return decoder.decode(decompressedBytes);
    }

    let fields;
    try {
      fields = JSON.parse(decompressText("{{ compressed }}"));
    } catch (error) {
      console.error("TRMNL Anki: could not read note data", error);
      return;
    }

    const values = Object.keys(fields)
      .map(function (key) { return fields[key]; })
      .filter(function (value) { return value && String(value).trim() !== ""; });

    const primary = layout.querySelector("[data-anki-primary]");
    const secondary = layout.querySelector("[data-anki-secondary]");

    // We intentionally don't escape the value since anki fields can contain styled HTML
    primary.innerHTML = values[0] || "";
    values.slice(1).forEach(function (value) {
      const field = document.createElement("div");
      field.innerHTML = value;
      secondary.appendChild(field);
    });
    if (!secondary.children.length) secondary.remove();
  });
</script>
{% endif %}
{% endtemplate %}
